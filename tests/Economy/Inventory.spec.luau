local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Fixtures = require(ServerScriptService.Tests.Economy.EconomyFixtures)
local ItemRegistry = require(ReplicatedStorage.Shared.Economy.ItemRegistry)
local SkinStore = require(ServerScriptService.Server.Services.Economy.SkinStore)

return function(t)
	t.test("items are tradeable unless tagged Untradeable", function()
		local w = Fixtures.world()
		t.expect(w.registry:IsTradeable("Weapon.Sword")).toBe(true)
		t.expect(w.registry:IsTradeable("Special.Heirloom")).toBe(false)
		t.expect(w.registry:IsTradeable("Missing.Item")).toBe(false)
	end)

	t.test("weapon skins cannot be defined as items", function()
		t.expect(function()
			ItemRegistry.new({ { id = "Skin.Gold", name = "Gold", description = "", category = "WeaponSkin" } })
		end).toThrow()
	end)

	t.test("only weapons carry a variationId", function()
		t.expect(function()
			ItemRegistry.new({ { id = "Material.X", name = "X", description = "", category = "Material", variationId = "Sword_Standard" } })
		end).toThrow()
	end)

	t.test("stackable grants fill existing stacks up to maxStack", function()
		local w = Fixtures.world()
		local p = w.player(1)
		w.give(p, "Material.Common", 30)
		w.give(p, "Material.Common", 30)
		local items = w.inventory:GetContainer(w.charKey(p))
		t.expect(#items).toBe(2)
		t.expect(w.inventory:CountOf(w.charKey(p), "Material.Common")).toBe(60)
	end)

	t.test("non-stackable grants create one instance each", function()
		local w = Fixtures.world()
		local p = w.player(1)
		w.inventory:Grant(w.charKey(p), "Weapon.Sword", 3)
		t.expect(#w.inventory:GetContainer(w.charKey(p))).toBe(3)
	end)

	t.test("a failing transfer in a batch changes nothing", function()
		local w = Fixtures.world()
		local a, b = w.player(1), w.player(2)
		local sword = w.give(a, "Weapon.Sword")
		local ore = w.give(a, "Material.Common", 10)
		local ok, reason = w.inventory:ApplyTransfers({
			{ uid = sword.uid, quantity = 1, from = w.charKey(a), to = w.charKey(b) },
			{ uid = ore.uid, quantity = 11, from = w.charKey(a), to = w.charKey(b) },
		})
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("InsufficientQuantity")
		t.expect(#w.inventory:GetContainer(w.charKey(a))).toBe(2)
		t.expect(#w.inventory:GetContainer(w.charKey(b))).toBe(0)
	end)

	t.test("the same uid cannot be claimed twice beyond its quantity", function()
		local w = Fixtures.world()
		local a, b = w.player(1), w.player(2)
		local ore = w.give(a, "Material.Common", 10)
		local ok, reason = w.inventory:ApplyTransfers({
			{ uid = ore.uid, quantity = 6, from = w.charKey(a), to = w.charKey(b) },
			{ uid = ore.uid, quantity = 6, from = w.charKey(a), to = w.charKey(b) },
		})
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("InsufficientQuantity")
	end)

	t.test("transfers check the item is in the claimed container", function()
		local w = Fixtures.world()
		local a, b = w.player(1), w.player(2)
		local sword = w.give(a, "Weapon.Sword")
		local ok, reason = w.inventory:ApplyTransfers({
			{ uid = sword.uid, quantity = 1, from = w.charKey(b), to = w.charKey(b) .. "x" },
		})
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("NotOwner")
	end)

	t.test("partial stack transfers split and merge", function()
		local w = Fixtures.world()
		local a, b = w.player(1), w.player(2)
		local ore = w.give(a, "Material.Common", 10)
		w.give(b, "Material.Common", 5)
		local ok = w.inventory:ApplyTransfers({ { uid = ore.uid, quantity = 4, from = w.charKey(a), to = w.charKey(b) } })
		t.expect(ok).toBe(true)
		t.expect(w.inventory:CountOf(w.charKey(a), "Material.Common")).toBe(6)
		t.expect(w.inventory:CountOf(w.charKey(b), "Material.Common")).toBe(9)
		t.expect(#w.inventory:GetContainer(w.charKey(b))).toBe(1)
	end)

	t.test("unique items keep their uid when they change owner", function()
		local w = Fixtures.world()
		local a, b = w.player(1), w.player(2)
		local sword = w.give(a, "Weapon.Sword")
		w.inventory:ApplyTransfers({ { uid = sword.uid, quantity = 1, from = w.charKey(a), to = w.charKey(b) } })
		t.expect(w.inventory:GetItem(sword.uid).container).toBe(w.charKey(b))
	end)

	t.test("serialize and load round-trip and skip unknown items", function()
		local w = Fixtures.world()
		local p = w.player(1)
		w.give(p, "Weapon.Sword")
		w.give(p, "Material.Rare", 3)
		local data = w.inventory:Serialize(w.charKey(p))
		table.insert(data, { uid = "x", itemId = "Removed.Item", quantity = 1 })
		local w2 = Fixtures.world()
		local skipped = w2.inventory:Load(w.charKey(p), data)
		t.expect(#skipped).toBe(1)
		t.expect(#w2.inventory:GetContainer(w.charKey(p))).toBe(2)
	end)

	t.test("change listeners receive every touched container", function()
		local w = Fixtures.world()
		local a, b = w.player(1), w.player(2)
		local sword = w.give(a, "Weapon.Sword")
		local seen
		w.inventory:OnChanged(function(keys)
			seen = keys
		end)
		w.inventory:ApplyTransfers({ { uid = sword.uid, quantity = 1, from = w.charKey(a), to = w.charKey(b) } })
		t.expect(seen[w.charKey(a)]).toBe(true)
		t.expect(seen[w.charKey(b)]).toBe(true)
	end)

	t.test("skins are account-wide and have no transfer", function()
		local owned = {}
		t.expect(SkinStore.Grant(owned, "Sword.Gold", 7, 0)).toBe(true)
		local ok, reason = SkinStore.Grant(owned, "Sword.Gold", 7, 0)
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("AlreadyOwned")
		t.expect(SkinStore.Owns(owned, "Sword.Gold")).toBe(true)
		t.expect(SkinStore.List(owned)).toEqual({ "Sword.Gold" })
		t.expect(SkinStore.Transfer).toBeNil()
		t.expect((SkinStore.Grant(owned, "", 7, 0))).toBe(false)
		t.expect((SkinStore.Revoke(owned, "Sword.Gold"))).toBe(true)
		t.expect(SkinStore.Owns(owned, "Sword.Gold")).toBe(false)
	end)
end
