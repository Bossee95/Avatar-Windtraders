local ServerScriptService = game:GetService("ServerScriptService")

local Fixtures = require(ServerScriptService.Tests.Specs.Economy.EconomyFixtures)

-- Opens a trade between two new players: a holds a sword, b holds 10 rare material.
local function openTrade(w)
	local a, b = w.player(1), w.player(2)
	local sword = w.give(a, "Weapon.Sword")
	local rare = w.give(b, "Material.Rare", 10)
	local ok, trade = w.trades:Request(a, b)
	assert(ok, trade)
	assert(w.trades:Respond(b, trade.id, true))
	return a, b, trade, sword, rare
end

local function confirmBoth(w, trade, a, b)
	assert(w.trades:Confirm(a, trade.id))
	assert(w.trades:Confirm(b, trade.id))
end

return function(t)
	t.test("a full trade swaps the items after the countdown", function()
		local w = Fixtures.world()
		local a, b, trade, sword, rare = openTrade(w)
		t.expect((w.trades:SetOffer(a, trade.id, { { uid = sword.uid, quantity = 1 } }))).toBe(true)
		t.expect((w.trades:SetOffer(b, trade.id, { { uid = rare.uid, quantity = 4 } }))).toBe(true)
		confirmBoth(w, trade, a, b)
		t.expect(trade.state).toBe("Countdown")

		w.advance(w.config.TradeCountdownSeconds - 1)
		t.expect(w.inventory:CountOf(w.charKey(b), "Weapon.Sword")).toBe(0)

		w.advance(1)
		t.expect(trade.state).toBe("Completed")
		t.expect(w.inventory:CountOf(w.charKey(b), "Weapon.Sword")).toBe(1)
		t.expect(w.inventory:CountOf(w.charKey(a), "Weapon.Sword")).toBe(0)
		t.expect(w.inventory:CountOf(w.charKey(a), "Material.Rare")).toBe(4)
		t.expect(w.inventory:CountOf(w.charKey(b), "Material.Rare")).toBe(6)
		t.expect(w.trades:GetTradeForPlayer(a)).toBeNil()
	end)

	t.test("completed trades are logged with players, items and time", function()
		local w = Fixtures.world()
		local a, b, trade, sword = openTrade(w)
		w.trades:SetOffer(a, trade.id, { { uid = sword.uid, quantity = 1 } })
		confirmBoth(w, trade, a, b)
		w.advance(w.config.TradeCountdownSeconds)
		local entries = w.log:Query({ playerUserId = 2, kind = "Trade" })
		t.expect(#entries).toBe(1)
		t.expect(entries[1].status).toBe("Completed")
		t.expect(entries[1].pdEventId).toBe("pd-1")
		t.expect(entries[1].parties[1].offered[1].itemId).toBe("Weapon.Sword")
		t.expect(entries[1].time).toBe(w.config.TradeCountdownSeconds)
		t.expect(#w.log:Query({ itemId = "Weapon.Sword" })).toBe(1)
	end)

	t.test("trading is refused when no PD is active", function()
		local w = Fixtures.world()
		w.pdActive = false
		local ok, reason = w.trades:Request(w.player(1), w.player(2))
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("NoActivePD")
	end)

	t.test("a PD ending during the countdown cancels the trade", function()
		local w = Fixtures.world()
		local a, b, trade, sword = openTrade(w)
		w.trades:SetOffer(a, trade.id, { { uid = sword.uid, quantity = 1 } })
		confirmBoth(w, trade, a, b)
		w.pdActive = false
		w.advance(10)
		t.expect(trade.state).toBe("Cancelled")
		t.expect(trade.reason).toBe("ValidationFailed:NoActivePD")
		t.expect(w.inventory:CountOf(w.charKey(a), "Weapon.Sword")).toBe(1)
	end)

	t.test("CancelAll closes every open trade and logs it", function()
		local w = Fixtures.world()
		local _, _, trade = openTrade(w)
		t.expect(w.trades:CancelAll("PDPaused")).toBe(1)
		t.expect(trade.state).toBe("Cancelled")
		t.expect(w.log:Query({ status = "Cancelled" })[1].reason).toBe("PDPaused")
	end)

	t.test("untradeable items cannot be offered", function()
		local w = Fixtures.world()
		local a, _, trade = openTrade(w)
		local heirloom = w.give(a, "Special.Heirloom")
		local ok, reason = w.trades:SetOffer(a, trade.id, { { uid = heirloom.uid, quantity = 1 } })
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("Untradeable")
	end)

	t.test("players cannot offer items they do not own", function()
		local w = Fixtures.world()
		local a, _, trade, _, rare = openTrade(w)
		local ok, reason = w.trades:SetOffer(a, trade.id, { { uid = rare.uid, quantity = 1 } })
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("NotOwner")
	end)

	t.test("offering more than the stack holds is refused", function()
		local w = Fixtures.world()
		local _, b, trade, _, rare = openTrade(w)
		local ok, reason = w.trades:SetOffer(b, trade.id, { { uid = rare.uid, quantity = 11 } })
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("InvalidQuantity")
	end)

	t.test("changing an offer clears both confirmations and stops the countdown", function()
		local w = Fixtures.world()
		local a, b, trade, sword, rare = openTrade(w)
		w.trades:SetOffer(a, trade.id, { { uid = sword.uid, quantity = 1 } })
		confirmBoth(w, trade, a, b)
		w.advance(2)
		w.trades:SetOffer(b, trade.id, { { uid = rare.uid, quantity = 1 } })
		t.expect(trade.state).toBe("Open")
		t.expect(trade.a.confirmed).toBe(false)
		t.expect(trade.b.confirmed).toBe(false)
		w.advance(30)
		t.expect(trade.state).toBe("Open")
		t.expect(w.inventory:CountOf(w.charKey(a), "Weapon.Sword")).toBe(1)
	end)

	t.test("either player can cancel during the countdown", function()
		local w = Fixtures.world()
		local a, b, trade, sword = openTrade(w)
		w.trades:SetOffer(a, trade.id, { { uid = sword.uid, quantity = 1 } })
		confirmBoth(w, trade, a, b)
		t.expect((w.trades:Cancel(b, trade.id))).toBe(true)
		w.advance(10)
		t.expect(trade.state).toBe("Cancelled")
		t.expect(w.inventory:CountOf(w.charKey(a), "Weapon.Sword")).toBe(1)
		t.expect(w.log:Query({})[1].cancelledBy).toBe(2)
	end)

	t.test("an item that leaves the inventory mid-countdown cancels the trade", function()
		local w = Fixtures.world()
		local a, b, trade, sword = openTrade(w)
		w.trades:SetOffer(a, trade.id, { { uid = sword.uid, quantity = 1 } })
		confirmBoth(w, trade, a, b)
		w.inventory:Remove(sword.uid)
		w.advance(10)
		t.expect(trade.state).toBe("Cancelled")
		t.expect(trade.reason).toBe("ValidationFailed:NotOwner")
		t.expect(w.inventory:CountOf(w.charKey(b), "Weapon.Sword")).toBe(0)
	end)

	t.test("a trade applies only once even if the countdown fires twice", function()
		local w = Fixtures.world()
		local a, b, trade, _, rare = openTrade(w)
		w.trades:SetOffer(b, trade.id, { { uid = rare.uid, quantity = 5 } })
		confirmBoth(w, trade, a, b)
		local token = trade._token
		w.advance(10)
		local ok, reason = w.trades:_finalize(trade, token)
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("Stale")
		t.expect(w.inventory:CountOf(w.charKey(a), "Material.Rare")).toBe(5)
		t.expect(w.inventory:CountOf(w.charKey(b), "Material.Rare")).toBe(5)
	end)

	t.test("combat-tagged players cannot trade, and tagging cancels at completion", function()
		local w = Fixtures.world()
		local a, b = w.player(1), w.player(2)
		w.inCombat[a] = true
		local ok, reason = w.trades:Request(a, b)
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("InCombat")

		local w2 = Fixtures.world()
		local a2, b2, trade, sword = openTrade(w2)
		w2.trades:SetOffer(a2, trade.id, { { uid = sword.uid, quantity = 1 } })
		confirmBoth(w2, trade, a2, b2)
		w2.inCombat[b2] = true
		w2.advance(10)
		t.expect(trade.reason).toBe("ValidationFailed:OtherInCombat")
	end)

	t.test("combat flag off allows trading in combat", function()
		local w = Fixtures.world({ BlockTradeInCombat = false })
		local a, b = w.player(1), w.player(2)
		w.inCombat[a] = true
		t.expect((w.trades:Request(a, b))).toBe(true)
	end)

	t.test("cross-faction trading follows the config flag", function()
		local w = Fixtures.world({ AllowCrossFactionTrade = false })
		local ok, reason = w.trades:Request(w.player(1, "FactionA"), w.player(2, "FactionB"))
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("CrossFactionTradeDisabled")
		local w2 = Fixtures.world()
		t.expect((w2.trades:Request(w2.player(1, "FactionA"), w2.player(2, "FactionB")))).toBe(true)
	end)

	t.test("traders must be within range", function()
		local w = Fixtures.world()
		local a, b = w.player(1), w.player(2)
		b.position = w.config.TradeRange + 1
		local ok, reason = w.trades:Request(a, b)
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("TooFar")
	end)

	t.test("requests expire and declines are logged", function()
		local w = Fixtures.world()
		local a, b = w.player(1), w.player(2)
		local _, trade = w.trades:Request(a, b)
		w.advance(w.config.TradeRequestTimeoutSeconds)
		t.expect(trade.state).toBe("Expired")

		local c, d = w.player(3), w.player(4)
		local _, trade2 = w.trades:Request(c, d)
		t.expect((w.trades:Respond(c, trade2.id, true))).toBe(false)
		w.trades:Respond(d, trade2.id, false)
		t.expect(trade2.state).toBe("Declined")
		t.expect(#w.log:Query({ kind = "Trade" })).toBe(2)
	end)

	t.test("a player can only be in one trade at a time", function()
		local w = Fixtures.world()
		local a, b, c = w.player(1), w.player(2), w.player(3)
		w.trades:Request(a, b)
		local ok, reason = w.trades:Request(c, a)
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("OtherAlreadyTrading")
	end)

	t.test("an empty trade cannot be confirmed", function()
		local w = Fixtures.world()
		local a, _, trade = openTrade(w)
		local ok, reason = w.trades:Confirm(a, trade.id)
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("NothingToTrade")
	end)

	t.test("a character change during the trade cancels it", function()
		local w = Fixtures.world()
		local a, b, trade, sword = openTrade(w)
		w.trades:SetOffer(a, trade.id, { { uid = sword.uid, quantity = 1 } })
		confirmBoth(w, trade, a, b)
		a.characterId = "1-2"
		w.advance(10)
		t.expect(trade.state).toBe("Cancelled")
	end)

	t.test("a trade cannot give a character a second weapon", function()
		local w = Fixtures.world()
		local a, b, trade, sword = openTrade(w)
		w.give(b, "Weapon.Bow")
		w.trades:SetOffer(a, trade.id, { { uid = sword.uid, quantity = 1 } })
		local ok, reason = w.trades:Confirm(a, trade.id)
		t.expect(ok).toBe(false)
		t.expect(reason).toBe("WeaponLimit")
		t.expect(w.inventory:CountCategory(w.charKey(b), "Weapon")).toBe(1)
	end)

	t.test("swapping one weapon for another is allowed", function()
		local w = Fixtures.world()
		local a, b, trade, sword = openTrade(w)
		local bow = w.give(b, "Weapon.Bow")
		w.trades:SetOffer(a, trade.id, { { uid = sword.uid, quantity = 1 } })
		w.trades:SetOffer(b, trade.id, { { uid = bow.uid, quantity = 1 } })
		confirmBoth(w, trade, a, b)
		w.advance(w.config.TradeCountdownSeconds)
		t.expect(trade.state).toBe("Completed")
		t.expect(w.inventory:CountOf(w.charKey(a), "Weapon.Bow")).toBe(1)
		t.expect(w.inventory:CountOf(w.charKey(b), "Weapon.Sword")).toBe(1)
	end)

	t.test("gaining a weapon during the countdown cancels a trade that would exceed the cap", function()
		local w = Fixtures.world()
		local a, b, trade, sword = openTrade(w)
		w.trades:SetOffer(a, trade.id, { { uid = sword.uid, quantity = 1 } })
		confirmBoth(w, trade, a, b)
		w.give(b, "Weapon.Bow")
		w.advance(w.config.TradeCountdownSeconds)
		t.expect(trade.reason).toBe("ValidationFailed:WeaponLimit")
		t.expect(w.inventory:CountOf(w.charKey(a), "Weapon.Sword")).toBe(1)
	end)
end
